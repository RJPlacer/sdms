<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sdms.controller.AboutController"
      prefWidth="560" prefHeight="540" styleClass="form-root">

    <HBox styleClass="about-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="24" right="26" bottom="24" left="26"/></padding>
        <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
            <image><Image url="@../images/SDO-Seal.png"/></image>
        </ImageView>
        <VBox spacing="3">
            <Label text="Athlete Track" styleClass="about-title"/>
            <Label text="Palarong Pambansa Delegation Management" styleClass="about-subtitle"/>
            <Label fx:id="lblVersion" text="Version" style="-fx-text-fill: #75C6DD; -fx-font-size: 10px;"/>
        </VBox>
    </HBox>

    <VBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="26" bottom="18" left="26"/></padding>

        <Label text="DATABASE SUMMARY" styleClass="section-kicker"/>
        <GridPane styleClass="summary-card" hgap="18" vgap="10">
            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
            <Label text="Athletes" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblAthleteCount" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #159CC8;"/>
            <Label text="Officials" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblOfficialCount" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1F9D78;"/>
            <Label text="Coaches" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblCoachCount" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #B97B13;"/>
            <Label text="Equipment records" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblEquipmentCount" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #B84C72;"/>
            <Label text="User accounts" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblUserCount" text="—" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #40576B;"/>
            <columnConstraints>
                <ColumnConstraints minWidth="185" hgrow="ALWAYS"/>
                <ColumnConstraints halignment="RIGHT"/>
            </columnConstraints>
        </GridPane>

        <HBox styleClass="summary-card" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <VBox spacing="2">
                <Label text="CURRENT SESSION" styleClass="section-kicker"/>
                <HBox spacing="8">
                    <Label text="Signed in as" style="-fx-text-fill: #718396;"/>
                    <Label fx:id="lblLoggedInUser" text="—" style="-fx-font-weight: bold; -fx-text-fill: #12364E;"/>
                    <Label fx:id="lblRole" text="" style="-fx-text-fill: #1597C2; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                <image><Image url="@../images/alfadevs-logo.jpg"/></image>
            </ImageView>
            <VBox spacing="2">
                <Label text="Designed and developed by AlfaDevs" style="-fx-font-weight: bold; -fx-text-fill: #12364E;"/>
                <Label text="Reniel John H. Placer · Sole creator and developer" style="-fx-text-fill: #718396; -fx-font-size: 10px;"/>
            </VBox>
        </HBox>
        <Label text="Built with JavaFX 21 · SQLite · ZXing · OpenPDF"
               style="-fx-font-size: 10px; -fx-text-fill: #8A9BAD;"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" styleClass="form-footer">
        <padding><Insets top="11" right="20" bottom="11" left="20"/></padding>
        <Button text="Close" onAction="#onClose" styleClass="btn-secondary"/>
    </HBox>
</VBox>
