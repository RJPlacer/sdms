<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sdms.controller.TeamDialogController"
      fx:id="root" styleClass="developer-dialog-root"
      prefWidth="760" prefHeight="620">

    <VBox styleClass="developer-hero" alignment="CENTER" spacing="8">
        <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
        <HBox alignment="CENTER" spacing="12">
            <ImageView fitWidth="58" fitHeight="58" preserveRatio="true">
                <image><Image url="@../images/alfadevs-logo.jpg"/></image>
            </ImageView>
            <Label text="AlfaDevs" styleClass="developer-brand"/>
        </HBox>
        <Label text="About the Developer" styleClass="developer-title"/>
        <Label text="The creator behind Athlete Track" styleClass="developer-subtitle"/>
    </VBox>

    <StackPane VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="34" bottom="22" left="34"/></padding>
        <HBox styleClass="developer-card" maxWidth="660" alignment="CENTER_LEFT" spacing="28">
            <padding><Insets top="26" right="30" bottom="26" left="30"/></padding>

            <StackPane styleClass="developer-photo-frame" minWidth="176" minHeight="202" prefWidth="176" prefHeight="202">
                <ImageView fitWidth="162" fitHeight="188" preserveRatio="true">
                    <image><Image url="@../images/reniel_formal_picture.jpg"/></image>
                </ImageView>
            </StackPane>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <VBox spacing="3">
                    <Label text="Reniel John H. Placer" styleClass="developer-name" wrapText="true"/>
                    <Label text="Founder &amp; Developer · AlfaDevs" styleClass="developer-role"/>
                </VBox>

                <Label text="Sole creator and lead developer of the Athlete Track Sports Delegation Management System. Built to make delegation records, identification, reporting, and QR verification simpler and more dependable."
                       styleClass="developer-copy" wrapText="true" maxWidth="390"/>

                <FlowPane hgap="7" vgap="7">
                    <Label text="APPLICATION DESIGN" styleClass="developer-badge"/>
                    <Label text="DESKTOP DEVELOPMENT" styleClass="developer-badge"/>
                    <Label text="ANDROID SCANNER" styleClass="developer-badge"/>
                    <Label text="DATABASE &amp; REPORTING" styleClass="developer-badge"/>
                </FlowPane>

                <Separator/>
                <Label text="Athlete Track is an independent AlfaDevs software product."
                       style="-fx-text-fill: #8293A3; -fx-font-size: 10px;" wrapText="true"/>
            </VBox>
        </HBox>
    </StackPane>

    <HBox alignment="CENTER_RIGHT" styleClass="form-footer">
        <padding><Insets top="11" right="22" bottom="11" left="22"/></padding>
        <Button text="Close" onAction="#onClose" styleClass="btn-secondary"/>
    </HBox>
</VBox>
