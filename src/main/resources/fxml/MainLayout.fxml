<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sdms.controller.MainController"
            stylesheets="@../css/style.css">
    <left>
        <VBox styleClass="sidebar" prefWidth="236">
            <VBox styleClass="sidebar-header" alignment="CENTER" spacing="4">
                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                <ImageView fitWidth="44" fitHeight="44" preserveRatio="true">
                    <image><Image url="@../images/SDO-Seal.png"/></image>
                </ImageView>
                <Label text="Athlete Track" styleClass="sidebar-title"/>
                <Label text="PALARONG PAMBANSA" styleClass="sidebar-subtitle"/>
            </VBox>

            <VBox spacing="2" style="-fx-padding: 8 10 0 10;">
                <Label text="MANAGEMENT" styleClass="sidebar-section-label"/>
                <Button fx:id="btnDashboard" text="Dashboard" maxWidth="Infinity" styleClass="nav-btn" onAction="#onNavDashboard"/>
                <Button fx:id="btnAthletes" text="Athletes" maxWidth="Infinity" styleClass="nav-btn" onAction="#onNavAthletes"/>
                <Button fx:id="btnOfficials" text="Officials" maxWidth="Infinity" styleClass="nav-btn" onAction="#onNavOfficials"/>
                <Button fx:id="btnCoaches" text="Coaches" maxWidth="Infinity" styleClass="nav-btn" onAction="#onNavCoaches"/>
                <Button fx:id="btnEquipment" text="Equipment" maxWidth="Infinity" styleClass="nav-btn" onAction="#onNavEquipment"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" minHeight="8"/>

            <VBox spacing="2" style="-fx-padding: 0 10 5 10;">
                <Label text="TOOLS" styleClass="sidebar-section-label"/>
                <Button fx:id="btnUsers" text="User Accounts" maxWidth="Infinity" styleClass="nav-btn" onAction="#onUserManagement"/>
                <Button text="Multi-PC Sharing" maxWidth="Infinity" styleClass="nav-btn" onAction="#onSharing"/>
                <Button text="Global Search" maxWidth="Infinity" styleClass="nav-btn" onAction="#onGlobalSearch"/>
                <Button text="Scan QR Code" maxWidth="Infinity" styleClass="nav-btn" onAction="#onScanQr"/>
                <Button text="Batch ID Cards" maxWidth="Infinity" styleClass="nav-btn" onAction="#onBatchPrint"/>
                <Button text="Print Roster" maxWidth="Infinity" styleClass="nav-btn" onAction="#onRoster"/>
            </VBox>

            <VBox styleClass="sidebar-user-card" spacing="3">
                <VBox.margin><Insets top="0" right="10" bottom="6" left="10"/></VBox.margin>
                <padding><Insets top="8" right="9" bottom="7" left="9"/></padding>
                <Label fx:id="lblCurrentUser" text="User" styleClass="sidebar-user-name"/>
                <Label fx:id="lblUserRole" text="Role" styleClass="sidebar-user-role"/>
                <Label fx:id="lblConnectionStatus" text="This computer only" wrapText="true" styleClass="sidebar-connection"/>
                <HBox spacing="8">
                    <Button text="Password" onAction="#onChangePassword" styleClass="sidebar-link-btn"/>
                    <Button text="About" onAction="#onAbout" styleClass="sidebar-link-btn"/>
                </HBox>
                <Button text="Log Out" maxWidth="Infinity" onAction="#onLogout" styleClass="sidebar-logout-btn"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

    <bottom>
        <HBox styleClass="app-footer" alignment="CENTER_LEFT" spacing="10" onMouseClicked="#onFooterClick">
            <padding><Insets top="7" right="14" bottom="7" left="14"/></padding>
            <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                <image><Image url="@../images/alfadevs-logo.jpg"/></image>
            </ImageView>
            <Label text="AlfaDevs" styleClass="app-footer-brand"/>
            <Label text="© 2026 · Athlete Track · Developed by Reniel John H. Placer" styleClass="app-footer-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="About the developer" styleClass="app-footer-hint"/>
        </HBox>
    </bottom>
</BorderPane>
